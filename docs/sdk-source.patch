@@ -0,0 +1,69 @@
+import { describe, it } from "vitest";
+import { createTestMetricsEnvironment } from "./helpers/test-metrics-environment";
+
+describe("portable test environment", () => {
+	it("uses real US default date formatting without discarding date values", ({
+		expect,
+	}) => {
+		expect(new Date("2026-02-01T00:00:00Z").toLocaleDateString()).toBe(
+			"2/1/2026"
+		);
+		expect(new Date("2024-01-02T00:00:00Z").toLocaleDateString()).toBe(
+			"1/2/2024"
+		);
+		expect(new Date("2024-01-01T00:00:00Z").toLocaleString()).toBe(
+			"1/1/2024, 12:00:00 AM"
+		);
+	});
+
+	it("preserves explicit locales, format options and invalid dates", ({
+		expect,
+	}) => {
+		const date = new Date("2026-02-01T00:00:00Z");
+		expect(date.toLocaleDateString("en-IL")).toBe(
+			new Intl.DateTimeFormat("en-IL").format(date)
+		);
+		expect(
+			date.toLocaleDateString("fr-FR", {
+				year: "numeric",
+				month: "long",
+				day: "numeric",
+				timeZone: "UTC",
+			})
+		).toBe("1 février 2026");
+		expect(new Date(NaN).toLocaleDateString()).toBe("Invalid Date");
+		expect(new Date(NaN).toLocaleString()).toBe("Invalid Date");
+	});
+
+	it("tests real telemetry environment parsing without touching ambient opt-outs", async ({
+		expect,
+	}) => {
+		const ambient = {
+			dnt: process.env.DO_NOT_TRACK,
+			metrics: process.env.WRANGLER_SEND_METRICS,
+		};
+		const fixture = await createTestMetricsEnvironment();
+		expect(fixture.getWranglerSendMetricsFromEnv()).toBeUndefined();
