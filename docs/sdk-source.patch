+import { readFileSync } from "node:fs";
+import { createContext, runInContext } from "node:vm";
+import { transformSync } from "esbuild";
+import { vi } from "vitest";
+import type * as EnvironmentFactories from "../../../../workers-utils/src/environment-variables/factory";
+import type * as WorkersUtils from "@cloudflare/workers-utils";
+
+const factorySource = transformSync(
+	readFileSync(
+		new URL(
+			"../../../../workers-utils/src/environment-variables/factory.ts",
+			import.meta.url
+		),
+		"utf8"
+	),
+	{ loader: "ts", format: "cjs" }
+).code;
+
+/**
+ * Exercise the real preference getters with fixture inputs, without changing
+ * the actual process opt-outs. This context loads no dispatcher or transport.
+ */
+export async function createTestMetricsEnvironment() {
+	const actual = await vi.importActual<typeof WorkersUtils>(
+		"@cloudflare/workers-utils"
+	);
+	const values: NodeJS.ProcessEnv = {};
+	const fixtureModule = { exports: {} };
+	const context = createContext({
+		module: fixtureModule,
+		exports: fixtureModule.exports,
+		process: Object.freeze({ env: values }),
+		require(specifier: string) {
+			if (specifier !== "../errors") {
+				throw new Error("Unexpected environment-factory import: " + specifier);
+			}
+			return { UserError: actual.UserError };
+		},
+	});
+	runInContext(factorySource, context);
+	const factories = fixtureModule.exports as typeof EnvironmentFactories;
+	context.getDoNotTrackFromEnv = factories.getEnvironmentVariableFactory({
+		variableName: "DO_NOT_TRACK",
+	});
+	context.getWranglerSendMetricsVariableFromEnv =
+		factories.getBooleanEnvironmentVariableFactory({
+			variableName: "WRANGLER_SEND_METRICS",
+		});
+	runInContext(
+		"globalThis.isDoNotTrackEnabled = (" +
+			actual.isDoNotTrackEnabled.toString() +
+			"); globalThis.getWranglerSendMetricsFromEnv = (" +
+			actual.getWranglerSendMetricsFromEnv.toString() +
+			");",
+		context
+	);
+	const getters = context as Pick<
+		typeof WorkersUtils,
+		"isDoNotTrackEnabled" | "getWranglerSendMetricsFromEnv"
+	>;
+	return {
+		getWranglerSendMetricsFromEnv: getters.getWranglerSendMetricsFromEnv,
+		isDoNotTrackEnabled: getters.isDoNotTrackEnabled,
+		set(name: "DO_NOT_TRACK" | "WRANGLER_SEND_METRICS", value: string) {
+			values[name] = value;
+		},
+		reset() {
+			delete values.DO_NOT_TRACK;
+			delete values.WRANGLER_SEND_METRICS;
+		},
+	};
+}
