+++ b/packages/wrangler/src/__tests__/helpers/test-locale.ts
@@ -0,0 +1,22 @@
+import { beforeEach, vi } from "vitest";
+
+const nativeFormats = {
+	toLocaleDateString: Date.prototype.toLocaleDateString,
+	toLocaleString: Date.prototype.toLocaleString,
+};
+
+/** Keep default-locale snapshots portable while retaining native formatting. */
+export function useDefaultTestLocale() {
+	beforeEach(() => {
+		for (const method of Object.keys(nativeFormats) as Array<
+			keyof typeof nativeFormats
+		>) {
+			vi.spyOn(Date.prototype, method).mockImplementation(function (
+				this: Date,
+				...args: Parameters<Date["toLocaleString"]>
+			) {
+				return nativeFormats[method].call(this, args[0] ?? "en-US", args[1]);
+			});
+		}
+	});
+}
